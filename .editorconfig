root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{py,ipynb}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,js,css,html}]
indent_style = space
indent_size = 2

[*.{cmd,bat}]
end_of_line = crlf
